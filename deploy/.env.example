# Copy to deploy/.env. Generate keys with: openssl rand -base64 32

# Traefik
BASELINE_HOST=baseline.example.com
# Agents dial this name through Traefik's TLS passthrough. It needs a DNS
# record pointing at Traefik, like BASELINE_HOST.
BASELINE_AGENT_HOST=agent.baseline.example.com
BASELINE_AGENT_PORT=443
# More names or IPs for the gateway certificate, comma-separated (e.g. the
# VPN IP when using the ports fallback in compose.yaml).
# BASELINE_GRPC_EXTRA_NAMES=10.8.0.1
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=

# Image. Unset: compose builds baseline-server:latest from source. To run a
# published release, pin its version (README.md, "Run it").
# BASELINE_IMAGE=ghcr.io/jw6ventures/baseline-server:v1.0.0
# Version of a build from source; unset, it's the newest schema migration's
# (db/migrations), e.g. v0.12.0.
# BASELINE_VERSION=

# Database
POSTGRES_PASSWORD=

# Server
BASELINE_PUBLIC_URL=https://baseline.example.com
BASELINE_COOKIE_KEY=
BASELINE_SECRET_KEY=
BASELINE_TZ=UTC
BASELINE_LOG_LEVEL=Info
# Vulnerability data (OSV). Empty: OSV's own bucket; or a mirror's URL, or
# "off". Ubuntu's dump is about 780 MB, read in full once a month.
# BASELINE_OSV_URL=

# Authentik: create an OAuth2/OpenID provider (confidential client) with
# redirect URI <public URL>/auth/callback. The issuer is the provider's
# "OpenID Configuration Issuer", e.g. https://auth.example.com/application/o/baseline/
BASELINE_OIDC_ISSUER=
BASELINE_OIDC_CLIENT_ID=
BASELINE_OIDC_CLIENT_SECRET=
# Members of this Authentik group are always admin, so the first sign-in can
# set up role bindings.
BASELINE_BOOTSTRAP_ADMIN_GROUP=authentik Admins
